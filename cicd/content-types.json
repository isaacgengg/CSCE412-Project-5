{
  "content_types": {
    ".html": "text/html; charset=utf-8",
    ".css": "text/css; charset=utf-8",
    ".js": "text/plain; charset=utf-8",
    ".json": "application/json",
    ".svg": "image/svg+xml",
    ".png": "image/png",
    ".jpg": "image/jpeg",
    ".ico": "image/x-icon",
    ".txt": "text/plain; charset=utf-8"
  },
  "no_cache": [".html", ".json"],
  "cache_control": {
    "no_cache": "no-cache",
    "default": "public, max-age=86400"
  }
}
